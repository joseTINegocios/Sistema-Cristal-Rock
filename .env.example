# GEMINI_API_KEY: Requerida para llamadas a la API de Gemini IA.
# AI Studio inyecta esto automáticamente en tiempo de ejecución desde los secretos del usuario.
# Los usuarios configuran esto a través del panel de Secretos en la interfaz de AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: La URL donde está alojada esta applet.
# AI Studio inyecta esto automáticamente en tiempo de ejecución con la URL del servicio Cloud Run.
# Utilizado para enlaces de autoreferencia, callbacks OAuth y endpoints de API.
APP_URL="MY_APP_URL"
